  },
  "GetProcessHeap": {
   "helper": "ss_get_process_heap",
   "arguments": 0,
   "returns": true,
   "guest_base": true,
   "why": "Starsiege's C runtime sends every malloc/free to the Win32 heap; port/starsiege/starsiege_fast_heap.c answers in constant time (TribesPad's list heap stalled start-up for 25 s). Blocks it did not allocate go to the original heap."
  },
