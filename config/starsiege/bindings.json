  "CreateSemaphoreA": {
   "helper": "ss_create_semaphore",
   "arguments": 4,
   "returns": true,
   "guest_base": true,
   "why": "Starsiege creates a named semaphore; TribesPad's service only creates unnamed ones. The wrapper adds the single-process name case and then calls it."
  },
