   "helper": "ss_get_system_metrics",
   "arguments": 1,
   "returns": true,
   "guest_base": true,
   "why": "Starsiege sizes its own window frame; adds the standard frame, border and input metrics and passes the rest to TribesPad's service."
  },
  "CreateWindowExA": {
   "helper": "ss_create_window_ex_a",
   "arguments": 12,
   "returns": true,
   "guest_base": false,
   "cpu_argument": true,
   "why": "Starsiege draws into its own Win32 window (WGL); TribesPad windows were hidden helpers for Tribes 2. Calls about hidden windows still go to the original service."
  },
