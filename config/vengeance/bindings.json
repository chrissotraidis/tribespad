 "overrides": {
  "RaiseException": {
   "helper": "vg_raise_exception",
   "arguments": 4,
   "returns": false,
   "guest_base": false,
   "cpu_argument": true,
   "helper_returns": "void",
   "why": "Tribes 2's RaiseException admits only the thread-name notification; Vengeance throws C++ exceptions (0xE06D7363) and uses __try/__except, so it gets full SEH dispatch (port/vengeance/vengeance_seh.c)."
  },
  "CreateFileW": {
   "helper": "vg_create_file_w",
   "arguments": 7,
   "returns": true,
   "guest_base": true,
   "why": "Unreal tests write permission by opening its own folder for GENERIC_WRITE with FILE_FLAG_BACKUP_SEMANTICS; TribesPad's CreateFileW opens directories read-only, so that case checks the host folder's write permission (port/vengeance/vengeance_win32.c). Every other call goes to TribesPad's service unchanged."
  },
  "GetProcAddress": {
   "helper": "vg_get_proc_address",
   "arguments": 2,
   "returns": true,
   "guest_base": true,
   "why": "Vengeance's translated modules answer from their own PE export tables (Unreal looks up native functions by name); other modules go to TribesPad's loader (port/vengeance/vengeance_engine.c)."
  }
 }
