+/* Bounds can span literal pools and jump tables in a code section. The
+   initial disassembler has already classified each output item. Only decoded
+   instructions belong in a lowering region; retain every data item unchanged
+   for the normal output writer (including relocatable daddr entries). */
+static void SR_insert_instruction_regions(unsigned int entry, uint_fast32_t begin, uint_fast32_t end)
+{
+    output_data *item = section_output_list_FindEntryEqualOrHigher(entry, begin);
+    uint_fast32_t first = 0, last = 0, next = 0;
+    int active = 0;
+    while (item != NULL && item->ofs <= end)
+    {
+        if (item->type == OT_INSTRUCTION)
+        {
+            if (active && item->ofs != next)
+            {
+                section_region_list_Insert(entry, first, last);
+                active = 0;
+            }
+            if (!active) { first = item->ofs; active = 1; }
+            last = item->ofs;
+            next = item->ofs + item->len + 1;
+        }
+        else if (active)
+        {
+            section_region_list_Insert(entry, first, last);
+            active = 0;
+        }
+        item = section_output_list_FindEntryHigher(entry, item->ofs);
+    }
+    if (active) section_region_list_Insert(entry, first, last);
+}
+
 static void SR_disassemble_create_regions(bound_data *item, void *data)
 {
