diff --git a/scripts/guarded_ir_check.py b/scripts/guarded_ir_check.py
new file mode 100644
index 0000000..480a348
--- /dev/null
+++ b/scripts/guarded_ir_check.py
@@ -0,0 +1,60 @@
+"""Structural audit of guarded IR emitted by the guest and external passes.
+
+Every guest load/store is immediately preceded by a full
+tribes_memory_access_begin, or by the token merge of a compiler-inlined check
+whose only fallback is that same full begin. A group never spans a call,
+fence or unrelated control flow outside the private tribes.guard.* blocks,
+retires 2..limit accesses through one end_many (or one access through end), and
+its count chain carries every begin token, including inlined fallbacks."""
+import re
+def check_guarded_groups(text,limit=16):
+ label='';open_=False;accesses=0;previous='';count=None;slow=set();stats=dict(groups=0,singles=0,inlined=0,maximum=0)
+ for line in text.splitlines():
+  s=line.strip()
+  if not s or s.startswith(';') or s.startswith('!') or s.startswith('declare') or s.startswith('attributes'):continue
+  m=re.match(r'^([-\w.$]+):(\s|$)',s)
+  if m:label=m[1];continue
+  if s.startswith('define '):assert not open_,s;label='';previous=s;continue
+  guard=label.startswith('tribes.guard.') and not label.startswith('tribes.guard.merge')
+  if 'call i32 @tribes_memory_access_begin(' in s:
+   token=s.split(' = ')[0]
+   if guard:assert label.startswith('tribes.guard.slow'),s;slow.add(token)
+   else:
+    if not open_:open_=True;accesses=0;count=token
+    else:
+     # Uninlined later access: its token joins the chain right after the access.
+     pass
+   previous=s;continue
+  if guard:
+   if re.search(r'\b(load|store)\b',s):assert ' store ' not in ' '+s and '!tribes.guard.fast' in s,s
+   assert not re.search(r'\b(call|atomicrmw|cmpxchg|fence|ret|switch)\b',s),s
+   previous=s;continue
+  if '= phi i32' in s:
+   assert open_ and 'tribes.guard.token' in s,s
+   incoming=re.findall(r'\[ ([^,]+), %',s);assert any(v in slow for v in incoming),s
+   stats['inlined']+=1;previous=s;continue
+  m=re.match(r'(%tribes.end.count[^ ]*) = add i32 ([^,]+), (.+)$',s)
+  if m:assert open_ and m[2]==count,(s,count);count=m[1];previous=s;continue
+  if 'call void @tribes_memory_access_end_many(' in s:
+   arg=re.search(r'\(i32 ([^)]+)\)',s)[1]
+   assert open_ and arg==count and 2<=accesses<=limit,(s,count,accesses)
+   stats['groups']+=1;stats['maximum']=max(stats['maximum'],accesses);open_=False;previous=s;continue
+  if 'call void @tribes_memory_access_end(' in s:
+   arg=re.search(r'\(i32 ([^)]+)\)',s)[1]
+   assert open_ and arg==count and accesses==1,(s,count,accesses)
+   stats['singles']+=1;stats['maximum']=max(stats['maximum'],1);open_=False;previous=s;continue
+  if re.search(r'\b(load|store|atomicrmw|cmpxchg)\b',s):
+   if '!tribes.checked.host.' in s:
+    assert re.search(r'\b(load|store)\b',s) and 'volatile' not in s,s
+    if open_:accesses+=1;assert accesses<=limit,s
+   else:
+    assert '@tribes_memory_access_begin(' in previous or 'tribes.end.count' in previous,(s,previous)
+    assert open_,s;accesses+=1;assert accesses<=limit,s
+    if 'volatile' in s or 'atomicrmw' in s or 'cmpxchg' in s:assert accesses==1,s
+   previous=s;continue
+  if s.startswith('br ') and open_ and 'tribes.guard.' in s:previous=s;continue
+  if re.search(r'\b(call|invoke|br|ret|fence|switch|unreachable)\b',s):assert not open_,s
+  previous=s
+ assert not open_
+ return stats
+
