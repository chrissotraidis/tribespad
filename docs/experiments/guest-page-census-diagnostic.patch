 static __attribute__((cold,noinline)) _Noreturn void violation(const void *p,uint64_t size,uint32_t access){fprintf(stderr,"TribesPad: checked guest memory violation at 0x%llx size=%llu access=%u\n",(unsigned long long)((uintptr_t)p-guest_base),(unsigned long long)size,access);abort();}
+/* Opt-in diagnostic (TRIBES_MEMORY_PAGE_CENSUS=1): how often would checked
+   guest accesses touch a 16 KiB host page whose 4 KiB permissions differ, or
+   write a host page that contains published code? Counts only; never changes
+   a check result. Called under the reader bracket, so permissions are stable. */
+static int census_enabled;
+static _Atomic uint64_t census_total,census_mixed,census_code_writes;
+static _Atomic uint32_t *census_pages;
+static __attribute__((noinline)) void census_report(uint64_t total){
+ uint64_t mixed=atomic_load_explicit(&census_mixed,memory_order_relaxed),code=atomic_load_explicit(&census_code_writes,memory_order_relaxed);
+ fprintf(stderr,"TribesPad page census: accesses=%llu mixed_host_page=%llu code_page_writes=%llu",(unsigned long long)total,(unsigned long long)mixed,(unsigned long long)code);
+ uint32_t pages=(uint32_t)(guest_size/16384),shown=0;
+ for(int round=0;round<8&&census_pages;round++){
+  uint32_t best=0,index=0;for(uint32_t h=0;h<pages;h++){uint32_t c=atomic_load_explicit(census_pages+h,memory_order_relaxed);if(c>best){best=c;index=h;}}
+  if(!best)break;atomic_store_explicit(census_pages+index,0,memory_order_relaxed);
+  fprintf(stderr," page@0x%x=%u[%u%u%u%u]",index*16384u,best,permissions[index*4],permissions[index*4+1],permissions[index*4+2],permissions[index*4+3]);shown++;
+ }
+ fputc('\n',stderr);(void)shown;
+}
+static __attribute__((noinline)) void census_count(uint64_t offset,uint64_t size,uint32_t access){
+ uint64_t total=atomic_fetch_add_explicit(&census_total,1,memory_order_relaxed)+1;
+ for(uint64_t h=offset/16384;h<=(offset+size-1)/16384;h++){
+  const unsigned char *q=permissions+h*4;
+  if(q[0]!=q[1]||q[0]!=q[2]||q[0]!=q[3]){atomic_fetch_add_explicit(&census_mixed,1,memory_order_relaxed);if(census_pages)atomic_fetch_add_explicit(census_pages+h,1,memory_order_relaxed);}
+  if((access&2)&&published_count){
+   for(uint32_t i=0;i<published_count;i++)if(published[i].begin<(h+1)*16384&&published[i].end>h*16384){atomic_fetch_add_explicit(&census_code_writes,1,memory_order_relaxed);break;}
+  }
+ }
+ if(!(total&((UINT64_C(1)<<27)-1)))census_report(total);
+}
