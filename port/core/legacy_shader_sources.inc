n\treturn -1.0 + w1(a) / (w0(a) + w1(a));\n}\n\nfloat h1(float a)\n{\n\treturn 1.0 + w3(a) / (w2(a) + w3(a));\n}\n\nvec4 textureBicubic(sampler2D tex, vec2 uv, vec2 res)\n{\n\tuv = uv * res + 0.5;\n\tvec2 iuv = floor( uv );\n\tvec2 fuv = fract( uv );\n\n\tfloat g0x = g0(fuv.x);\n\tfloat g1x = g1(fuv.x);\n\tfloat h0x = h0(fuv.x);\n\tfloat h1x = h1(fuv.x);\n\tfloat h0y = h0(fuv.y);\n\tfloat h1y = h1(fuv.y);\n\n\tvec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - 0.5) / res;\n\tvec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - 0.5) / res;\n\tvec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - 0.5) / res;\n\tvec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - 0.5) / res;\n\n\treturn g0(fuv.y) * (g0x * texture(tex, p0)  +\n\t\t\t\t\t\tg1x * texture(tex, p1)) +\n\t\t\tg1(fuv.y) * (g0x * texture(tex, p2)  +\n\t\t\t\t\t\tg1x * texture(tex, p3));\n}\n\nfloat fixedToFloat(uint h)\n{\n\treturn float(h) * 0.03125;\n}\n\nvec2 getFogCoordPair(float dist, float z)\n{\n\treturn vec2(\n\t\t(visibleDistance - dist) * invVisibleDistance,\n\t\t(z - fogHeightOffset) * invHeightRange\n\t);\n}\n\nvec3 getBaseDiffuseGrad(vec2 splatUV, float detailBias)\n{\n\tvec2 splatUVNorm = splatUV * invSplatMapSize.xy;\n\tvec4 splatLO = texture(splatMap, vec3(splatUVNorm, 0));\n\tvec4 splatHI = texture(splatMap, vec3(splatUVNorm, 1));\n\n\tvec2 texUV = vec2(-wsPosition.x, wsPosition.y) * invSquareSize * materialTilesPerMeter;\n\tvec2 gradX = dFdx(texUV) * detailBias;\n\tvec2 gradY = dFdy(texUV) * detailBias;\n\n\tvec3 color = vec3(0.0);\n\n\t#define SPLAT_MAT(weight, idx) \\\n\t\tif (weight > 0.01) \\\n\t\t{ \\\n\t\t\tvec3 tex = textureGrad(materialTex[idx], texUV, gradX, gradY).rgb; \\\n\t\t\tcolor += weight * tex; \\\n\t\t}\n\n\tSPLAT_MAT(splatLO.r, 0);\n\tSPLAT_MAT(splatLO.g, 1);\n\tSPLAT_MAT(splatLO.b, 2);\n\tSPLAT_MAT(splatLO.a, 3);\n\tSPLAT_MAT(splatHI.r, 4);\n\tSPLAT_MAT(splatHI.g, 5);\n\tSPLAT_MAT(splatHI.b, 6);\n\tSPLAT_MAT(splatHI.a, 7);\n\n\t#undef SPLAT_MAT\n\n\treturn color;\n}\n\nvoid main()\n{\n\tfloat dist = distance(wsCamera, wsPosition);\n\tvec2 fogCoord = getFogCoordPair(dist, wsPosition.z);\n\tvec4 fog = texture(fogTex, fogCoord);\n\n\tif (fog.a > 0.999999)\n\t{\n\t\tfragColor = vec4(fog.rgb, 1.0);\n\t\treturn;\n\t}\n\n\tvec2 lightUV = (wsPosition.xy * (heightmapTexelsPerMeter / 2)) * invLightMapSize;\n\tvec4 light = textureBicubic(lightMap, lightUV, vec2(512));\n\n\tfloat distFactor = clamp((zeroDetailDistance - dist) / zeroDetailDistance, 0.0, 1.0);\n\tfloat detailFactor = (1.0 - fog.a) * distFactor;\n\n\t// float distanceBias = clamp((dist - zeroDetailDistance) / (visibleDistance - zeroDetailDistance), 0.0, 1.0);\n\n\tvec3 diffuse = getBaseDiffuseGrad(wsPosition.xy * invSquareSize, materialBias);\n\n\tvec4 detail = texture(detailTex, detailUV);\n\tvec3 modulated = diffuse.rgb * detail.rgb;\n\n\tdiffuse = mix(diffuse.rgb, modulated, (detail.a * detailFactor));\n\n\tvec3 dynamic;\n\tfor (int i = 0; i < lightCount; i++)\n\t{\n\t\tfloat lightDist = distance(lightPosRadius[i].xyz, wsPosition.xyz);\n\t\tfloat attenuation = clamp(1.0 - lightDist / lightPosRadius[i].a, 0.0, 1.0);\n\n\t\t// closer to lightFalloffMono? (if blending with diffuse)\n\t\t// attenuation = pow(attenuation, 0.75);\n\t\tattenuation *= attenuation;\n\t\tdynamic += lightColor[i].rgb * attenuation;\n\t}\n\n\tvec3 baked = diffuse * light.rgb * light.a;\n\t// dynamic *= diffuse;\n\n\tfragColor = mix(vec4(baked + dynamic, 1.0), vec4(fog.rgb, 1.0), clamp(fog.a, 0.0, 1.0));\n}\n\n#endif // DEPTH_ONLY\n","#version 120\n#extension GL_EXT_gpu_shader4 : require\n#extension GL_EXT_texture_array : require\n#extension GL_ARB_shader_texture_lod : require\n\n#extension GL_ARB_conservative_depth: enable\n\n#if __VERSION__>=420\n\tlayout(early_fragment_tests) in;\n#else\n\t#extension GL_ARB_shader_image_load_store: enable\n\n\t#ifdef GL_ARB_shader_image_load_store\n\t\tlayout(early_fragment_tests) in;\n\t#endif\n#endif // __VERSION__\n\n#ifdef GL_ARB_conservative_depth\n\tlayout (depth_unchanged) out float gl_FragDepth;\n#endif\n\n\n\n","\n#ifdef DEPTH_ONLY\n\nvoid main()\n{\n\t// Bye\n}\n\n#else // !DEPTH_ONLY\n\nuniform sampler2D heightMap;\nuniform int heightMapSize = 1024;\n\nuniform sampler2D lightMap; // 512\nconst vec2 invLightMapSize = vec2(1.0 / 512.0);\n\nuniform sampler2DArray splatMap; // 256\nconst vec2 invSplatMapSize = vec2(1.0 / 256.0);\n\nuniform sampler2D materialTex[8];\nuniform int materialBias = 0;\nuniform float materialTilesPerMeter = 0.125;\n\nuniform float squareSize = 8;\nuniform float invSquareSize;\n\nuniform float heightmapTexelsPerMeter;\n\nuniform float invBaseGridSizeTexels;\n\nuniform sampler2D detailTex;\nuniform float zeroDetailDistance;\n\nuniform float visibleDistance;\nuniform float invVisibleDistance;\n\nuniform sampler2D fogTex;\nuniform float fogHeightOffset;\nuniform float invHeightRange;\n\nuniform vec4 lightPosRadius[64];\nuniform vec4 lightColor[64];\nuniform int lightCount = 0;\n\nvarying vec2 detailUV;\n\nvarying vec3 wsPosition;\nvarying vec3 wsCamera;\n\n\n\n// w0, w1, w2, and w3 are the four cubic B-spline basis functions\nfloat w0(float a)\n{\n\treturn (1.0/6.0)*(a*(a*(-a + 3.0) - 3.0) + 1.0);\n}\n\nfloat w1(float a)\n{\n\treturn (1.0/6.0)*(a*a*(3.0*a - 6.0) + 4.0);\n}\n\nfloat w2(float a)\n{\n\treturn (1.0/6.0)*(a*(a*(-3.0*a + 3.0) + 3.0) + 1.0);\n}\n\nfloat w3(float a)\n{\n\treturn (1.0/6.0)*(a*a*a);\n}\n\n// g0 and g1 are the two amplitude functions\nfloat g0(float a)\n{\n\treturn w0(a) + w1(a);\n}\n\nfloat g1(float a)\n{\n\treturn w2(a) + w3(a);\n}\n\n// h0 and h1 are the two offset functions\nfloat h0(float a)\n{\n\treturn -1.0 + w1(a) / (w0(a) + w1(a));\n}\n\nfloat h1(float a)\n{\n\treturn 1.0 + w3(a) / (w2(a) + w3(a));\n}\n\nvec4 textureBicubic(sampler2D tex, vec2 uv, vec2 res)\n{\n\tuv = uv * res + 0.5;\n\tvec2 iuv = floor( uv );\n\tvec2 fuv = fract( uv );\n\n\tfloat g0x = g0(fuv.x);\n\tfloat g1x = g1(fuv.x);\n\tfloat h0x = h0(fuv.x);\n\tfloat h1x = h1(fuv.x);\n\tfloat h0y = h0(fuv.y);\n\tfloat h1y = h1(fuv.y);\n\n\tvec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - 0.5) / res;\n\tvec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - 0.5) / res;\n\tvec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - 0.5) / res;\n\tvec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - 0.5) / res;\n\n\treturn g0(fuv.y) * (g0x * texture2D(tex, p0)  +\n\t\t\t\t\t\tg1x * texture2D(tex, p1)) +\n\t\t\tg1(fuv.y) * (g0x * texture2D(tex, p2)  +\n\t\t\t\t\t\tg1x * texture2D(tex, p3));\n}\n\nfloat fixedToFloat(unsigned int h)\n{\n\treturn float(h) * 0.03125;\n}\n\nvec2 getFogCoordPair(float dist, float z)\n{\n\treturn vec2(\n\t\t(visibleDistance - dist) * invVisibleDistance,\n\t\t(z - fogHeightOffset) * invHeightRange\n\t);\n}\n\nvec3 getBaseDiffuseGrad(vec2 splatUV, float detailBias)\n{\n\tvec2 splatUVNorm = splatUV * invSplatMapSize.xy;\n\tvec4 splatLO = texture2DArray(splatMap, vec3(splatUVNorm, 0));\n\tvec4 splatHI = texture2DArray(splatMap, vec3(splatUVNorm, 1));\n\n\tvec2 texUV = vec2(-wsPosition.x, wsPosition.y) * invSquareSize * materialTilesPerMeter;\n\tvec2 gradX = dFdx(texUV) * detailBias;\n\tvec2 gradY = dFdy(texUV) * detailBias;\n\n\tvec3 color = vec3(0.0);\n\n\t#define SPLAT_MAT(weight, idx) \\\n\t\tif (weight > 0.01) \\\n\t\t{ \\\n\t\t\tvec3 tex = texture2DGradARB(materialTex[idx], texUV, gradX, gradY).rgb; \\\n\t\t\tcolor += weight * tex; \\\n\t\t}\n\n\tSPLAT_MAT(splatLO.r, 0);\n\tSPLAT_MAT(splatLO.g, 1);\n\tSPLAT_MAT(splatLO.b, 2);\n\tSPLAT_MAT(splatLO.a, 3);\n\tSPLAT_MAT(splatHI.r, 4);\n\tSPLAT_MAT(splatHI.g, 5);\n\tSPLAT_MAT(splatHI.b, 6);\n\tSPLAT_MAT(splatHI.a, 7);\n\n\t#undef SPLAT_MAT\n\n\treturn color;\n}\n\nvoid main()\n{\n\tfloat dist = distance(wsCamera, wsPosition);\n\tvec2 fogCoord = getFogCoordPair(dist, wsPosition.z);\n\tvec4 fog = texture2D(fogTex, fogCoord);\n\n\tif (fog.a > 0.999999)\n\t{\n\t\tgl_FragColor = vec4(fog.rgb, 1.0);\n\t\treturn;\n\t}\n\n\tvec2 lightUV = (wsPosition.xy * (heightmapTexelsPerMeter / 2)) * invLightMapSize;\n\tvec4 light = textureBicubic(lightMap, lightUV, vec2(512));\n\n\tfloat distFactor = clamp((zeroDetailDistance - dist) / zeroDetailDistance, 0.0, 1.0);\n\tfloat detailFactor = (1.0 - fog.a) * distFactor;\n\n\t// float distanceBias = clamp((dist - zeroDetailDistance) / (visibleDistance - zeroDetailDistance), 0.0, 1.0);\n\n\tvec3 diffuse = getBaseDiffuseGrad(wsPosition.xy * invSquareSize, materialBias);\n\n\tvec4 detail = texture2D(detailTex, detailUV);\n\tvec3 modulated = diffuse.rgb * detail.rgb;\n\n\tdiffuse = mix(diffuse.rgb, modulated, (detail.a * detailFactor));\n\n\tvec3 dynamic;\n\tfor (int i = 0; i < lightCount; i++)\n\t{\n\t\tfloat lightDist = distance(lightPosRadius[i].xyz, wsPosition.xyz);\n\t\tfloat attenuation = clamp(1.0 - lightDist / lightPosRadius[i].a, 0.0, 1.0);\n\n\t\t// closer to lightFalloffMono? (if blending with diffuse)\n\t\t// attenuation = pow(attenuation, 0.75);\n\t\tattenuation *= attenuation;\n\t\tdynamic += lightColor[i].rgb * attenuation;\n\t}\n\n\tvec3 baked = diffuse * light.rgb * light.a;\n\t// dynamic *= diffuse;\n\n\tgl_FragColor = mix(vec4(baked + dynamic, 1.0), vec4(fog.rgb, 1.0), clamp(fog.a, 0.0, 1.0));\n}\n\n#endif // DEPTH_ONLY\n"},
 {"terrain.vert",1,"#version 150 compatibility\n\n","\n\nuniform sampler2D heightMap;\nuniform int heightMapSize = 1024;\n\nuniform float squareSize = 8;\n\nuniform float metersPerHeightmapTexel;\nuniform float heightmapTexelsPerMeter;\n\nuniform vec3 offsetPosition;\n\n#ifdef DEPTH_ONLY\nuniform bool isHoly = false;\n#else\nuniform sampler2D detailTex;\nout vec2 detailUV;\n#endif\n\nout vec3 wsPosition;\nout vec3 wsCamera;\n\nvec2 roundToIncrement(vec2 value, float increment)\n{\n\treturn round(value * (1.0 / increment)) * increment;\n}\n\nvoid main()\n{\n\twsCamera = gl_ModelViewMatrixInverse[3].xyz;\n\n\tfloat gridLevel = gl_Vertex.z;\n\tfloat gridMetersPerHeightmapTexel = metersPerHeightmapTexel * 4;\n\tfloat mipMetersPerHeightmapTexel = gridMetersPerHeightmapTexel * exp2(gridLevel);\n\n\tvec2 objectToWorld = roundToIncrement(wsCamera.xy + offsetPosition.xy, mipMetersPerHeightmapTexel);\n\n\twsPosition = vec3(gl_Vertex.x * gridMetersPerHeightmapTexel + objectToWorld.x, gl_Vertex.y * gridMetersPerHeightmapTexel + objectToWorld.y, 0.0);\n\n#ifndef DEPTH_ONLY\n\tdetailUV = wsPosition.xy * (62.0 / textureSize(detailTex, 0).x);\n#endif\n\n\tfloat invHeightMapSize = 1.0 / heightMapSize;\n\tvec2 heightSample = textureLod(heightMap, (wsPosition.xy * heightmapTexelsPerMeter) * invHeightMapSize, 0).rg;\n\n#ifdef DEPTH_ONLY\n\t// Only the holiest of holy terrain may have empty squares marked within the primary terrain block area\n\tvec2 endPos = vec2(squareSize * 256);\n\n\tif (isHoly && (wsPosition.x > 0 && wsPosition.x < endPos.x && wsPosition.y > 0 && wsPosition.y < endPos.y) && heightSample.g < 0)\n\t{\n\t\t// bunch a degens\n\t#if __VERSION__>=330\n\t\tgl_Position = vec4(intBitsToFloat(int(0xFFC00000u)));\n\t#else\n\t\tgl_Position = vec4(0.0 / 0.0);\n\t#endif\n\t}\n\telse\n#endif\n\t{\n\t\twsPosition.z = heightSample.r;\n\t\tgl_Position = vec4(wsPosition, 1.0) * gl_ModelViewProjectionMatrixTranspose;\n\t}\n}\n","#version 120\n#extension GL_EXT_gpu_shader4 : require\n#extension GL_EXT_texture_array : require\n#extension GL_ARB_shader_texture_lod : require\n\n","\n\nuniform sampler2D heightMap;\nuniform int heightMapSize = 1024;\n\nuniform float squareSize = 8;\n\nuniform float metersPerHeightmapTexel;\nuniform float heightmapTexelsPerMeter;\n\nuniform vec3 offsetPosition;\n\n#ifdef DEPTH_ONLY\nuniform bool isHoly = false;\n#else\nuniform sampler2D detailTex;\nvarying vec2 detailUV;\n#endif\n\nvarying vec3 wsPosition;\nvarying vec3 wsCamera;\n\nvec2 roundToIncrement(vec2 value, float increment)\n{\n\treturn round(value * (1.0 / increment)) * increment;\n}\n\nvoid main()\n{\n\twsCamera = gl_ModelViewMatrixInverse[3].xyz;\n\n\tfloat gridLevel = gl_Vertex.z;\n\tfloat gridMetersPerHeightmapTexel = metersPerHeightmapTexel * 4;\n\tfloat mipMetersPerHeightmapTexel = gridMetersPerHeightmapTexel * exp2(gridLevel);\n\n\tvec2 objectToWorld = roundToIncrement(wsCamera.xy + offsetPosition.xy, mipMetersPerHeightmapTexel);\n\n\twsPosition = vec3(gl_Vertex.x * gridMetersPerHeightmapTexel + objectToWorld.x, gl_Vertex.y * gridMetersPerHeightmapTexel + objectToWorld.y, 0.0);\n\n#ifndef DEPTH_ONLY\n\tdetailUV = wsPosition.xy * (62.0 / textureSize2D(detailTex, 0).x);\n#endif\n\n\tfloat invHeightMapSize = 1.0 / heightMapSize;\n\tvec2 heightSample = texture2DLod(heightMap, (wsPosition.xy * heightmapTexelsPerMeter) * invHeightMapSize, 0).rg;\n\n#ifdef DEPTH_ONLY\n\t// Only the holiest of holy terrain may have empty squares marked within the primary terrain block area\n\tvec2 endPos = vec2(squareSize * 256);\n\n\tif (isHoly && (wsPosition.x > 0 && wsPosition.x < endPos.x && wsPosition.y > 0 && wsPosition.y < endPos.y) && heightSample.g < 0)\n\t{\n\t\t// bunch a degens\n\t#if __VERSION__>=330\n\t\tgl_Position = vec4(intBitsToFloat(int(0xFFC00000u)));\n\t#else\n\t\tgl_Position = vec4(0.0 / 0.0);\n\t#endif\n\t}\n\telse\n#endif\n\t{\n\t\twsPosition.z = heightSample.r;\n\t\tgl_Position = vec4(wsPosition, 1.0) * gl_ModelViewProjectionMatrixTranspose;\n\t}\n}\n"},
 {"text.frag",0,"#version 150 compatibility\n\nuniform sampler2DArray glyphTex;\nuniform float uiScale;\n\nout vec4 FragColor;\n\nflat in int glyphSheet;\nflat in ivec4 charBounds;\nin vec2 texCoord;\n\nvoid main()\n{\n\tvec2 st = texCoord - 0.5;\n\tivec2 i = ivec2( floor( st ) );\n\tvec2  w = fract( st );\n\n\tivec2 uvt = ivec2(0);\n\tivec2 uv = i+ivec2(0,0);\n\tuv.x = max(uv.x, charBounds.x);\n\tuv.y = max(uv.y, charBounds.y);\n\tvec4 a = texelFetch( glyphTex, ivec3(uv, glyphSheet), 0 );\n\n\t//uv = i + ivec2(1,0);\n\tuvt.x = uv.x;\n\tuv.x = min(i.x + 1, (charBounds.x + charBounds.z) - 1);\n\tvec4 b = texelFetch(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\t// i+ivec2(0,1)\n\tuvt.y = uv.x;\n\tuv.x = uvt.x;\n\tuv.y = min(i.y + 1, (charBounds.y + charBounds.w) - 1);\n\tvec4 c = texelFetch(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\t// i+ivec2(1,1)\n\tuv.x = uvt.y;\n\tvec4 d = texelFetch(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\tvec4 texColor = mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n\n\n\tfloat alpha = gl_Color.a * texColor.r;\n\tFragColor = vec4(gl_Color.rgb * alpha, alpha);\n}\n","","#version 120\n#extension GL_EXT_gpu_shader4 : require\n#extension GL_EXT_texture_array : require\n#extension GL_ARB_shader_texture_lod : require\n\nuniform sampler2DArray glyphTex;\nuniform float uiScale;\n\n\n\nflat varying int glyphSheet;\nflat varying ivec4 charBounds;\nvarying vec2 texCoord;\n\nvoid main()\n{\n\tvec2 st = texCoord - 0.5;\n\tivec2 i = ivec2( floor( st ) );\n\tvec2  w = fract( st );\n\n\tivec2 uvt = ivec2(0);\n\tivec2 uv = i+ivec2(0,0);\n\tuv.x = max(uv.x, charBounds.x);\n\tuv.y = max(uv.y, charBounds.y);\n\tvec4 a = texelFetch2DArray( glyphTex, ivec3(uv, glyphSheet), 0 );\n\n\t//uv = i + ivec2(1,0);\n\tuvt.x = uv.x;\n\tuv.x = min(i.x + 1, (charBounds.x + charBounds.z) - 1);\n\tvec4 b = texelFetch2DArray(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\t// i+ivec2(0,1)\n\tuvt.y = uv.x;\n\tuv.x = uvt.x;\n\tuv.y = min(i.y + 1, (charBounds.y + charBounds.w) - 1);\n\tvec4 c = texelFetch2DArray(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\t// i+ivec2(1,1)\n\tuv.x = uvt.y;\n\tvec4 d = texelFetch2DArray(glyphTex, ivec3(uv, glyphSheet), 0);\n\n\tvec4 texColor = mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n\n\n\tfloat alpha = gl_Color.a * texColor.r;\n\tgl_FragColor = vec4(gl_Color.rgb * alpha, alpha);\n}\n",""},
 {"text.vert",0,"#version 150 compatibility\n\nin uvec3 coords;\nin uvec4 charData;\n\nflat out int glyphSheet;\nflat out ivec4 charBounds;\nout vec2 texCoord;\n\nvoid main()\n{\n\tgl_FrontColor = gl_Color;\n\tgl_Position = ftransform();\n\n\ttexCoord = vec2(coords.x, coords.y);\n\tcharBounds = ivec4(charData);\n\tglyphSheet = int(coords.z);\n}\n","","#version 120\n#extension GL_EXT_gpu_shader4 : require\n#extension GL_EXT_texture_array : require\n#extension GL_ARB_shader_texture_lod : require\n\nattribute uvec3 coords;\nattribute uvec4 charData;\n\nflat varying int glyphSheet;\nflat varying ivec4 charBounds;\nvarying vec2 texCoord;\n\nvoid main()\n{\n\tgl_FrontColor = gl_Color;\n\tgl_Position = ftransform();\n\n\ttexCoord = vec2(coords.x, coords.y);\n\tcharBounds = ivec4(charData);\n\tglyphSheet = int(coords.z);\n}\n",""},
 {"textMSDF.frag",0,"#version 150 compatibility\n\nuniform sampler2D msdf;\nuniform float screenPxRange = 4.0;\n\nout vec4 fragColor;\n\nfloat median(float r, float g, float b)\n{\n\treturn max(min(r, g), min(max(r, g), b));\n}\n\nvoid main()\n{\n\tvec2 texCoord = gl_TexCoord[0].st;\n\n\tfloat alpha = 0;\n\tvec3 msd = textureLod(msdf, texCoord, 0).rgb;\n\tfloat sd = median(msd.r, msd.g, msd.b);\n\n\tfloat screenPxDistance = screenPxRange * (sd - 0.5);\n\talpha = clamp(screenPxDistance + 0.5, 0.0, 1.0) * gl_Color.a;\n\n\tfragColor = vec4(gl_Color.rgb * alpha, alpha);\n}\n","","#version 120\n#extension GL_EXT_gpu_shader4 : require\n#extension GL_EXT_texture_array : require\n#extension GL_ARB_shader_texture_lod : require\n\nuniform sampler2D msdf;\nuniform float screenPxRange = 4.0;\n\n\n\nfloat median(float r, float g, float b)\n{\n\treturn max(min(r, g), min(max(r, g), b));\n}\n\nvoid main()\n{\n\tvec2 texCoord = gl_TexCoord[0].st;\n\n\tfloat alpha = 0;\n\tvec3 msd = texture2DLod(msdf, texCoord, 0).rgb;\n\tfloat sd = median(msd.r, msd.g, msd.b);\n\n\tfloat screenPxDistance = screenPxRange * (sd - 0.5);\n\talpha = clamp(screenPxDistance + 0.5, 0.0, 1.0) * gl_Color.a;\n\n\tgl_FragColor = vec4(gl_Color.rgb * alpha, alpha);\n}\n",""},
